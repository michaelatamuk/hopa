<Window x:Class="Hopa.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HOPA"
        Height="760" Width="1140"
        Background="#F7F4EE"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True"
        Drop="Window_Drop"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="MessageTemplate">
            <Border Background="{Binding Fill}" CornerRadius="16" Padding="14,10" Margin="16,4"
                    MaxWidth="640" HorizontalAlignment="{Binding Align}">
                <TextBlock Text="{Binding Text}" Foreground="{Binding Ink}" FontSize="14"
                           TextWrapping="Wrap" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ConversationTemplate">
            <StackPanel Margin="8,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"
                               Foreground="#1C1B18" />
                    <TextBlock Text="{Binding PinLabel}" FontSize="9" FontWeight="SemiBold"
                               Foreground="#E8703A" Margin="6,2,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding UpdatedLabel}" FontSize="11" Foreground="#9A9488" />
                    <TextBlock Text="{Binding ArchivedLabel}" FontSize="10" Foreground="#9A9488"
                               Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#F3EFE7">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#E8703A" VerticalAlignment="Center" />
                        <TextBlock Text="HOPA" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0"
                                   Foreground="#1C1B18" />
                    </StackPanel>
                    <Button Content="+ New chat" Margin="0,12,0,0" Height="34"
                            Background="#FFFFFF" BorderBrush="#E9E4DA" Click="NewChat_Click"
                            AutomationProperties.Name="New chat" />
                    <TextBox x:Name="SearchBox" Margin="0,10,0,0" Height="30"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="Search conversations"
                             TextChanged="SearchBox_TextChanged" />
                    <CheckBox x:Name="ShowArchivedBox" Content="Show archived" Margin="0,8,0,0"
                              FontSize="11" Foreground="#6B665C" Click="ShowArchived_Click"
                              AutomationProperties.Name="Show archived conversations" />
                </StackPanel>
                <Button DockPanel.Dock="Bottom" x:Name="SettingsButton" Content="Settings"
                        Margin="12,8,12,12" Height="32" Background="Transparent"
                        BorderThickness="0" Foreground="#6B665C" Click="Settings_Click"
                        AutomationProperties.Name="Settings" />
                <ListBox x:Name="ConversationList" BorderThickness="0" Background="Transparent"
                         ItemTemplate="{StaticResource ConversationTemplate}"
                         SelectionChanged="ConversationList_SelectionChanged"
                         AutomationProperties.Name="Conversations">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Pin / Unpin" Click="Pin_Click" />
                            <MenuItem Header="Archive / Unarchive" Click="Archive_Click" />
                            <MenuItem Header="Rename" Click="Rename_Click" />
                            <MenuItem Header="Export..." Click="Export_Click" />
                            <MenuItem Header="Delete" Click="Delete_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="#E9E4DA" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F7F4EE" BorderBrush="#E9E4DA" BorderThickness="0,0,0,1">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Text="New chat" VerticalAlignment="Center"
                               FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18"
                               AutomationProperties.Name="Conversation title" />
                    <TextBlock x:Name="StatusText" Grid.Column="1" Text="" VerticalAlignment="Center"
                               Margin="12,0" FontSize="11" Foreground="#9A9488" />
                    <Button x:Name="CopyButton" Grid.Column="2" Content="Copy" Width="46" Height="26"
                            Margin="0,0,6,0" Background="Transparent" BorderThickness="0"
                            Foreground="#6B665C" IsEnabled="False" Click="Copy_Click"
                            AutomationProperties.Name="Copy the last answer" />
                    <Button x:Name="SpeakButton" Grid.Column="3" Content="Speak" Width="50" Height="26"
                            Margin="0,0,6,0" Background="Transparent" BorderThickness="0"
                            Foreground="#6B665C" IsEnabled="False" Click="Speak_Click"
                            AutomationProperties.Name="Read the last answer aloud" />
                    <Button x:Name="DetailsButton" Grid.Column="4" Content="Run" Width="44" Height="26"
                            Margin="0,0,8,0" Background="Transparent" BorderThickness="0"
                            Foreground="#6B665C" IsEnabled="False" Click="Details_Click"
                            AutomationProperties.Name="Run details" />
                    <StackPanel x:Name="WindowButtons" Grid.Column="5" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="MinimizeButton" Content="&#x2013;" Width="34" Height="28"
                                Background="Transparent" BorderThickness="0" Foreground="#6B665C"
                                Click="Minimize_Click" />
                        <Button x:Name="MaximizeButton" Content="&#x25A1;" Width="34" Height="28"
                                Background="Transparent" BorderThickness="0" Foreground="#6B665C"
                                Click="Maximize_Click" />
                        <Button x:Name="CloseButton" Content="&#x2715;" Width="34" Height="28"
                                Background="Transparent" BorderThickness="0" Foreground="#6B665C"
                                Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MessagesList" ItemTemplate="{StaticResource MessageTemplate}" />
                </ScrollViewer>
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="Assets/mascot.png" Width="132" Height="132" />
                    <TextBlock Text="Ask me something." FontSize="15" Foreground="#9A9488"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>

            <Border x:Name="PendingAttachmentBar" Grid.Row="2" Margin="16,8,16,0"
                    Background="#F3EFE7" CornerRadius="12" Padding="10,8" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PendingAttachmentName" FontSize="12"
                                   Foreground="#1C1B18" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PendingAttachmentDetail" FontSize="10" Foreground="#9A9488" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Remove" Width="66" Height="26"
                            Background="Transparent" BorderThickness="0" Foreground="#6B665C"
                            Click="RemoveAttachment_Click"
                            AutomationProperties.Name="Remove attachment" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Margin="16,8,16,16" Background="#FFFFFF" CornerRadius="18"
                    BorderBrush="#E9E4DA" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Composer" BorderThickness="0" Background="Transparent"
                             FontSize="14" TextWrapping="Wrap" MinHeight="38"
                             VerticalContentAlignment="Center" KeyDown="Composer_KeyDown"
                             AutomationProperties.Name="Message" />
                    <Button x:Name="MicButton" Grid.Column="1" Content="Mic" Width="56" Height="38"
                            Margin="0,0,6,0" Background="Transparent" BorderThickness="0"
                            Foreground="#6B665C" Click="Mic_Click"
                            AutomationProperties.Name="Dictate a message" />
                    <Button x:Name="SendButton" Grid.Column="2" Content="Send" Width="84" Height="38"
                            Background="#0A59F7" Foreground="#FFFFFF" BorderThickness="0"
                            Click="Send_Click" AutomationProperties.Name="Send message" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
